#!/usr/bin/env bash
# macOS Application Bundle Launcher for CropYield-ST
DIR="$(cd "$(dirname "$0")/../../.." && pwd)"
cd "$DIR"

if command -v python3 >/dev/null 2>&1; then
    PY_CMD="python3"
else
    PY_CMD="python"
fi

# If virtualenv exists, use it
if [ -f ".venv/bin/activate" ]; then
    source .venv/bin/activate
fi

$PY_CMD run_app.py
